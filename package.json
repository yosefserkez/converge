{
  "name": "converge",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "provision": "node --experimental-strip-types scripts/provision.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "cleanup": "node --experimental-strip-types scripts/cleanup.ts",
    "dev": "pnpm --filter @converge/control dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration && pnpm --filter @converge/control test:workers",
    "test:e2e": "playwright test",
    "deploy:dev": "node --experimental-strip-types scripts/deploy.ts --env dev",
    "deploy:prod": "node --experimental-strip-types scripts/deploy.ts --env prod"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "wrangler": "4.147.0",
    "jose": "6.2.12"
  }
}
