{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "converge-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "services": [{ "binding": "CONTROL", "service": "converge", "entrypoint": "PreviewEntrypoint" }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/p/*", "/api/*", "/healthz"]
  },
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "prod" }
}
